--- a/lib/mdnsd/mdnsd.c
+++ b/lib/mdnsd/mdnsd.c
@@ -1140,6 +1140,50 @@ void mdnsd_announce(mdnsd_t *mdnsd, uint32_t ttl)
     MUTEX_UNLOCK(mdnsd->mutex);
 }
 
+/* iPhone Screenshare pool patch: several UxPlay instances on this host use the same service name,
+ * so the _airplay._tcp PTR (-> name._airplay._tcp), the _services._dns-sd._udp PTRs and the host's
+ * A/AAAA records are the same as the free instance's. A goodbye only says that this instance's own
+ * SRV and TXT are gone, without the cache-flush bit, which would remove the free instance's too, plus
+ * the _raop._tcp PTR, whose target (MAC@name, from -m) belongs to this instance alone. */
+static void mdns_send_goodbye_locked(mdnsd_t *mdnsd, const mdnsd_service_t *service,
+                                     mdns_family_t family)
+{
+    mdns_packet_t packet;
+    size_t count_pos;
+    size_t rdlength_pos;
+    unsigned int answers;
+
+    if (!service->registered || mdns_begin_response(&packet, &count_pos)) {
+        return;
+    }
+    if (mdns_begin_rr(&packet, service->name, DNS_TYPE_SRV, DNS_CLASS_IN, 0, &rdlength_pos) ||
+        mdns_put_u16(&packet, 0) ||
+        mdns_put_u16(&packet, 0) ||
+        mdns_put_u16(&packet, service->port) ||
+        mdns_put_name(&packet, mdnsd->host_name)) {
+        return;
+    }
+    mdns_end_rr(&packet, rdlength_pos);
+    if (mdns_begin_rr(&packet, service->name, DNS_TYPE_TXT, DNS_CLASS_IN, 0, &rdlength_pos) ||
+        mdns_put_bytes(&packet, service->txt.bytes, (size_t) service->txt.length)) {
+        return;
+    }
+    mdns_end_rr(&packet, rdlength_pos);
+    answers = 2;
+    if (strcmp(service->type, "_raop._tcp.local") == 0) {
+        if (mdns_add_ptr(&packet, service->type, service->name, 0)) {
+            return;
+        }
+        answers++;
+    }
+    mdns_finish_response(&packet, count_pos, answers);
+    if (family == MDNS_FAMILY_IPV4) {
+        mdns_send_packet4(mdnsd, &packet, NULL);
+    } else {
+        mdns_send_packet6(mdnsd, &packet, NULL);
+    }
+}
+
 void mdnsd_goodbye(mdnsd_t *mdnsd, const mdnsd_service_t *service)
 {
     if (!mdnsd || !service) {
@@ -1147,7 +1191,7 @@ void mdnsd_goodbye(mdnsd_t *mdnsd, const mdnsd_service_t *service)
     }
 
     MUTEX_LOCK(mdnsd->mutex);
-    mdns_send_service_locked(mdnsd, service, 0, 0, MDNS_FAMILY_IPV4, NULL);
-    mdns_send_service_locked(mdnsd, service, 0, 0, MDNS_FAMILY_IPV6, NULL);
+    mdns_send_goodbye_locked(mdnsd, service, MDNS_FAMILY_IPV4);
+    mdns_send_goodbye_locked(mdnsd, service, MDNS_FAMILY_IPV6);
     MUTEX_UNLOCK(mdnsd->mutex);
 }
