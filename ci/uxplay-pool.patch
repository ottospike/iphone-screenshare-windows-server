-#ifdef DBUS
+/* iPhone Screenshare pool patch: an instance that is mirroring removes its mDNS advertisement, so the
+ * next device only sees the free instance, and adds it again when mirroring stops. Every instance
+ * has the same service name and announces with the cache-flush bit, so the devices then resolve
+ * the name to this instance (it announced last): the app takes it as the free one and takes down
+ * the other idle one. If announcing again fails, it stays hidden and the app restarts it.
+ * mirror_video_running() is called from RAOP threads (stream setup, and the end of the mirror thread);
+ * the dnssd calls are not thread-safe, so they run on the GLib main loop, the thread that also does
+ * the first register_dnssd() and the final stop_dnssd(). Each call queues its own event, in order. */
+static bool dnssd_mirror_hidden = false;  /* main thread only */
+
+/* One announcement can be lost (multicast on Wi-Fi), and the app kills the other idle instance
+ * without a goodbye about 5-6 s after this one announces: announce again at +1 s, +3 s and +8 s
+ * (RFC 6762 8.3), so a cache-flush SRV/TXT sent more than 1 s after the other instance's answers
+ * replaces them. register_dnssd() on registered services rebuilds the TXT and announces again.
+ * Each repeat is logged, so the app times "announced last" from the last packet sent. */
+static gboolean dnssd_announce_again (gpointer data) {
+    (void) data;
+    if (dnssd && !dnssd_mirror_hidden && register_dnssd() == 0) {
+        LOGI("mDNS: announced again");
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void dnssd_announce_repeats () {
+    g_timeout_add(1000, dnssd_announce_again, NULL);
+    g_timeout_add(3000, dnssd_announce_again, NULL);
+    g_timeout_add(8000, dnssd_announce_again, NULL);
+}
+
+static gboolean dnssd_mirror_apply (gpointer data) {
+    bool running = (GPOINTER_TO_INT(data) != 0);
+    if (!dnssd) {
+        return G_SOURCE_REMOVE;
+    }
+    if (running && !dnssd_mirror_hidden) {
+        unregister_dnssd();
+        dnssd_mirror_hidden = true;
+        LOGI("mDNS: hidden while mirroring");
+    } else if (!running && dnssd_mirror_hidden) {
+        if (register_dnssd() == 0) {
+            dnssd_mirror_hidden = false;
+            LOGI("mDNS: mirroring ended, advertised again");
+            dnssd_announce_repeats();
+        } else {
+            unregister_dnssd();  /* a service registered before the failure: hidden for real */
+            LOGI("mDNS: mirroring ended, advertising again failed: still hidden");
+        }
+    }
+    return G_SOURCE_REMOVE;
+}
+
 extern "C" void mirror_video_running  (void *cls, bool is_running) {
+    g_idle_add(dnssd_mirror_apply, GINT_TO_POINTER(is_running ? 1 : 0));
+#ifdef DBUS
     if (scrsv != 1) {
         return;
     }
     dbus_screensaver_inhibiter(is_running);
-}
 #endif
+}
 
